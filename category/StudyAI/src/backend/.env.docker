APP_NAME=StudyAI Backend
API_PREFIX=/api
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/studyai

LM_STUDIO_BASE_URL=http://host.docker.internal:5858/v1
LLM_MODEL=qwen3.5-27b
VLM_MODEL=qwen3.5-27b
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

AI_PROVIDER=lmstudio

UPLOAD_DIR=/app/backend/data/uploads
MODEL_TIMEOUT_SECONDS=600
MAX_UPLOAD_SIZE_MB=10
MAX_BULK_FILES=5
TEXT_PDF_THRESHOLD=50
MLFLOW_TRACKING_URI=sqlite:////app/backend/data/mlflow.db
MLFLOW_EXPERIMENT_NAME=system01_invoice_extraction
SYSTEM02_MLFLOW_EXPERIMENT_NAME=system02_contract_risk_review
SYSTEM16_MLFLOW_EXPERIMENT_NAME=system16_project_skill_matching

WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
