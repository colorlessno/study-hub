APP_NAME=StudyAI Backend
API_PREFIX=/api
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studyai
LM_STUDIO_BASE_URL=http://localhost:5858/v1
LLM_MODEL=qwen3-27b-q4
VLM_MODEL=qwen3-vl-32b-q4
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
UPLOAD_DIR=./data/uploads
MODEL_TIMEOUT_SECONDS=25
MAX_UPLOAD_SIZE_MB=10
MAX_BULK_FILES=5
TEXT_PDF_THRESHOLD=50
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
MLFLOW_EXPERIMENT_NAME=system01_invoice_extraction
SYSTEM02_MLFLOW_EXPERIMENT_NAME=system02_contract_risk_review
SYSTEM16_MLFLOW_EXPERIMENT_NAME=system16_project_skill_matching

# System14 ローカル・ダミーCRM（system14_mainを8014番で起動する場合）
SYSTEM14_DUMMY_CRM_ENDPOINT=http://127.0.0.1:8014/api/dummy-crm/activities
SYSTEM14_DUMMY_CRM_TOKEN=change-this-local-demo-token

# System14 ローカル配信サンドボックス（Mailpitはdocker composeで起動）
SYSTEM14_WEBHOOK_SINK_ENDPOINT=http://127.0.0.1:8014/api/delivery-sandbox/webhook
SYSTEM14_WEBHOOK_BEARER_TOKEN=change-this-local-webhook-token
SYSTEM14_SMTP_HOST=127.0.0.1
SYSTEM14_SMTP_PORT=11025
SYSTEM14_SMTP_FROM=system14@studyai.local
SYSTEM14_SMTP_TLS=false
SYSTEM14_MAILPIT_API_URL=http://127.0.0.1:18025/api/v1/messages
SYSTEM14_MAILPIT_PUBLIC_URL=http://127.0.0.1:18025

# AI プロバイダ設定（lmstudio / custom）
AI_PROVIDER=lmstudio
# AI_PROVIDER=custom の場合は以下を設定
# CUSTOM_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4       # GLM の例
# CUSTOM_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  # Gemini の例
# CUSTOM_AI_API_KEY=your_api_key_here
# CUSTOM_LLM_MODEL=glm-4            # GLM の例
# CUSTOM_LLM_MODEL=gemini-1.5-pro    # Gemini の例
# CUSTOM_EMBEDDING_MODEL=embedding-3  # GLM の例
