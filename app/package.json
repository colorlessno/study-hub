{
  "name": "study-hub-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:frontend && npm run dev:server",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:frontend": "vite",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc -p tsconfig.server.json",
    "build:frontend": "tsc -p tsconfig.frontend.json --noEmit && vite build",
    "start": "node dist-server/server/main.js",
    "test": "vitest run --no-file-parallelism --pool=forks"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "ajv": "^8.0.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
