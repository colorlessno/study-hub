{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudyHub actual field catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "numberedThemeCount", "fields"],
  "definitions": {
    "repositoryPath": {
      "type": "string",
      "pattern": "^category/[^.].*"
    },
    "fieldCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args", "timeoutSeconds"],
      "properties": {
        "command": { "enum": ["node", "npm", "python"] },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 10, "maximum": 600 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "check"],
      "properties": {
        "mode": { "enum": ["check-only", "managed-check", "manual-app"] },
        "managesCleanup": { "type": "boolean" },
        "startGuide": {
          "allOf": [
            { "$ref": "#/definitions/repositoryPath" },
            { "type": "string", "pattern": "\\.md$" }
          ]
        },
        "check": { "$ref": "#/definitions/fieldCheck" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "managed-check" } } },
          "then": {
            "required": ["managesCleanup"],
            "properties": { "managesCleanup": { "const": true } }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "manual-app" } } },
          "then": {
            "required": ["startGuide"],
            "properties": { "startGuide": {} }
          }
        }
      ]
    },
    "themeDirectories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentationRoot", "implementationRoots"],
      "properties": {
        "documentationRoot": { "$ref": "#/definitions/repositoryPath" },
        "implementationRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/repositoryPath" }
        }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "const": "study-hub" },
    "numberedThemeCount": { "const": 163 },
    "fields": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "path",
          "entryFile",
          "numberedThemes",
          "unitKind",
          "lifecycle"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^study-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "pattern": "^Study[A-Za-z0-9]+$" },
          "path": { "$ref": "#/definitions/repositoryPath" },
          "entryFile": {
            "allOf": [
              { "$ref": "#/definitions/repositoryPath" },
              { "type": "string", "pattern": "\\.md$" }
            ]
          },
          "themePrefix": { "type": "string", "pattern": "^[a-z]+$" },
          "themeDirectories": { "$ref": "#/definitions/themeDirectories" },
          "numberedThemes": { "type": "integer", "minimum": 0, "maximum": 52 },
          "unitKind": {
            "enum": [
              "document",
              "exercise",
              "implementation",
              "application",
              "shared-environment",
              "mixed"
            ]
          },
          "lifecycle": { "$ref": "#/definitions/lifecycle" }
        },
        "allOf": [
          {
            "if": { "properties": { "numberedThemes": { "type": "integer", "minimum": 1 } } },
            "then": {
              "required": ["themePrefix", "themeDirectories"],
              "properties": {
                "themePrefix": { "type": "string", "pattern": "^[a-z]+$" },
                "themeDirectories": { "$ref": "#/definitions/themeDirectories" }
              }
            },
            "else": {
              "properties": {
                "themePrefix": false,
                "themeDirectories": false
              }
            }
          }
        ]
      }
    }
  }
}
