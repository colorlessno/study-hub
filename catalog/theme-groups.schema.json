{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "groups"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fieldId", "name", "summary", "order", "themeIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "fieldId": { "type": "string", "pattern": "^study-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "themeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "listProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["interactionMode"],
            "properties": {
              "interactionMode": {
                "enum": ["read-only", "screen-operation", "single-action", "multiple-actions", "stateful-sequence"]
              },
              "initialization": { "type": "string", "minLength": 1 },
              "environmentScope": { "type": "string", "minLength": 1 },
              "cleanupImpact": { "type": "string", "minLength": 1 },
              "relationshipNote": { "type": "string", "minLength": 1 },
              "outputNote": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["themeId", "interactionMode"],
        "properties": {
          "themeId": { "type": "string", "minLength": 1 },
          "interactionMode": {
            "enum": ["read-only", "screen-operation", "single-action", "multiple-actions", "stateful-sequence"]
          },
          "initialization": { "type": "string", "minLength": 1 },
          "environmentScope": { "type": "string", "minLength": 1 },
          "cleanupImpact": { "type": "string", "minLength": 1 },
          "relationshipNote": { "type": "string", "minLength": 1 },
          "outputNote": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
