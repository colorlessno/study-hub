{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogType",
    "checklistCount",
    "checklists"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogType": {
      "const": "sample"
    },
    "checklistCount": {
      "type": "integer",
      "minimum": 1
    },
    "checklists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "revision",
          "themeId",
          "title",
          "items"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "themeId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
