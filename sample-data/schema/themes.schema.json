{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogType", "themes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogType": { "const": "sample" },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/theme" }
    }
  },
  "$defs": {
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "args"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "command": { "const": "node" },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/" },
        "healthUrl": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/" }
      }
    },
    "requestOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "method", "url"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "method": { "enum": ["GET", "POST", "PATCH", "DELETE", "OPTIONS"] },
        "url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/" },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "label", "target"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "target": { "enum": ["path", "body", "query", "header"] },
              "type": { "enum": ["string", "boolean"] },
              "required": { "type": "boolean" },
              "placeholder": { "type": "string" }
            }
          }
        }
      }
    },
    "commandOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "processes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "processes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/process" }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "defaultValue": { "type": "string" },
            "placeholder": { "type": "string" }
          }
        }
      }
    },
    "themeResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "format", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["material", "readme", "source", "requirements", "design", "template", "artifact"]
        },
        "format": { "enum": ["markdown", "text", "source"] },
        "path": { "type": "string", "pattern": "^materials/(?!.*\\.\\.)[a-zA-Z0-9_./-]+$" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fieldId", "name", "summary", "presentation", "lifecycle", "material", "environment", "operations"],
      "properties": {
        "id": { "type": "string", "pattern": "^sample-[a-z0-9-]+$" },
        "fieldId": { "type": "string", "pattern": "^sample-[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "presentation": {
          "enum": ["document", "web", "request", "command", "external-app"]
        },
        "lifecycle": {
          "enum": ["none", "one-shot", "process", "stack", "shared", "manual"]
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "openMode"],
          "properties": {
            "path": { "type": "string", "pattern": "^materials/(?!.*\\.\\.)[a-zA-Z0-9_./-]+$" },
            "openMode": { "enum": ["embedded", "new-window", "none"] }
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/themeResource" }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "open": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {
                "mode": { "enum": ["embedded", "new-window"] }
              }
            },
            "start": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runtimeId", "processes"],
              "properties": {
                "runtimeId": { "type": "string", "pattern": "^sample-[a-z0-9-]+$" },
                "processes": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/process" }
                }
              }
            },
            "run": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {
                "mode": { "enum": ["command", "request"] },
                "method": { "enum": ["GET", "POST", "PATCH", "DELETE", "OPTIONS"] },
                "url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/" },
                "requests": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/requestOperation" }
                },
                "commandOperations": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/commandOperation" }
                },
                "process": { "$ref": "#/$defs/process" },
                "autoStopAfterRun": { "type": "boolean" }
              }
            },
            "stop": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {
                "mode": { "enum": ["managed", "release"] }
              }
            }
          }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    }
  }
}
